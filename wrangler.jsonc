{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stagepilot",
  "account_id": "d938fa80fa642dcf97042f4f4ce5f1b3",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-02-14",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "stagepilot-db",
      "database_id": "70463ee1-f37b-4638-8571-ad236ee28398"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "STAGE_ROOM",
        "class_name": "StageRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "StageRoom"
      ]
    }
  ],
  "observability": {
    "enabled": true
  }
}
